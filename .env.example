# Contact form → n8n webhook (client-side; must be set at build time on Vercel)
NEXT_PUBLIC_WEBHOOK_URL=https://your-n8n.com/webhook/contact

# Nodemailer fallback (server-side, used by /api/send-mail when the webhook fails)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=you@gmail.com
RECIPIENT_EMAIL=you@gmail.com
